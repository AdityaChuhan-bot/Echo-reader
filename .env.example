# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# OPENAI_API_KEY: Optional premium voice provider for human-like narration.
OPENAI_API_KEY=MY_OPENAI_API_KEY

# ELEVENLABS_API_KEY: Optional premium hyper-realistic voice provider.
ELEVENLABS_API_KEY=MY_ELEVENLABS_API_KEY

# GOOGLE_CLOUD_API_KEY: Optional fallback high-fidelity neural voice provider.
GOOGLE_CLOUD_API_KEY=MY_GOOGLE_CLOUD_API_KEY
